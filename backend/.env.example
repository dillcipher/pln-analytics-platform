# ==========================================================
# APPLICATION
# ==========================================================

APP_NAME=PLN Analytics Platform API
ENVIRONMENT=development
DEBUG=true

# ==========================================================
# CORS
# ==========================================================

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# ==========================================================
# AUTH
# ==========================================================

# Public dashboard by default.
# Enable BOTH flags only when the frontend login flow is enabled.
AUTH_ENABLED=false
AUTH_REQUIRED=false
JWT_SECRET_KEY=CHANGE-ME-IN-PRODUCTION
JWT_EXPIRES_MINUTES=480

# ==========================================================
# DATA
# ==========================================================

DATA_PROCESSED_DIR=./data/processed
DATA_RAW_DIR=./data/raw
DATA_INCOMING_DIR=./data/raw/incoming
DATA_AUTH_DIR=./data/auth

# ==========================================================
# PERFORMANCE
# ==========================================================

DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=500
CACHE_TTL_SECONDS=120
