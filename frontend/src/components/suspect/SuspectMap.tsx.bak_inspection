                📍 Buka di Google Maps
            </button>

        </div>
    );
}


/* ============================================================
 * MAIN COMPONENT
 * ============================================================ */

export default function SuspectMap({
    points,
    height = 560,
}: SuspectMapProps) {

    /*
     * Defensive filtering.
     *
     * Data invalid tidak dikirim
     * ke Leaflet.
     */
    const validPoints =
        useMemo(() => {

            return points.filter(
                (point) => {

                    const latitude =
                        Number(
                            point.latitude,
                        );

                    const longitude =
                        Number(
                            point.longitude,
                        );


                    return (
                        Number.isFinite(
                            latitude,
                        ) &&
                        Number.isFinite(
                            longitude,
                        )
                    );
                },
            );

        }, [points]);


    return (
        <div
            style={{
                position:
                    "relative",
                width: "100%",
                height,
                minHeight: 300,
                overflow: "hidden",
                borderRadius: 12,
                background:
                    "#0f1b2d",
            }}
        >

            <MapContainer
                center={
                    DEFAULT_CENTER
                }
                zoom={
                    DEFAULT_ZOOM
                }
                scrollWheelZoom
                preferCanvas
                style={{
                    width: "100%",
                    height: "100%",
                    minHeight: 300,
                }}
            >

                {/* ==========================================
                 * BASE MAP
                 * ========================================== */}

                <TileLayer
                    attribution="&copy; OpenStreetMap contributors"
                    url="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
                />


                {/* ==========================================
                 * FIT BOUNDS
                 * ========================================== */}

                <MapFitter
                    points={
                        validPoints
                    }
                />


                {/* ==========================================
                 * SUSPECT POINTS
                 * ========================================== */}

                {validPoints.map(
                    (
                        point,
                        index,
                    ) => {

                        const color =
                            getPointColor(
                                point.suspect_name,
                            );


                        /*
                         * Jangan hanya location_code.
                         *
                         * Satu lokasi dapat mempunyai
                         * lebih dari satu klasifikasi suspect.
                         */
                        const key = [
                            point.location_code,
                            point.idpel ??
                                "",
                            point.suspect_name ??
                                "",
                            point.latitude,
                            point.longitude,
                            index,
                        ].join(
                            "-",
                        );


                        return (
                            <CircleMarker
                                key={key}
                                center={[
                                    Number(
                                        point.latitude,
                                    ),
                                    Number(
                                        point.longitude,
                                    ),
                                ]}
                                radius={5}
                                pathOptions={{
                                    color,
                                    fillColor:
                                        color,
                                    fillOpacity:
                                        0.78,
                                    weight: 1,
                                }}
                            >

                                <Popup
                                    maxWidth={
                                        380
                                    }
                                >

                                    <SuspectPopup
                                        point={
                                            point
                                        }
                                    />

                                </Popup>

                            </CircleMarker>
                        );
                    },
                )}

            </MapContainer>


            {/* =================================================
             * EMPTY STATE
             * ================================================= */}

            {validPoints.length ===
                0 && (
                <div
                    style={{
                        position:
                            "absolute",
                        inset: 0,
                        zIndex: 400,
                        display:
                            "flex",
                        alignItems:
                            "center",
                        justifyContent:
                            "center",
                        pointerEvents:
                            "none",
                    }}
                >

                    <div
                        style={{
                            padding:
                                "10px 16px",
                            borderRadius: 8,
                            background:
                                "rgba(7, 17, 31, 0.82)",
                            border:
                                "1px solid #2c3b52",
                            color:
                                "#829bbd",
                            fontSize: 13,
                        }}
                    >
                        Tidak ada lokasi suspect
                        yang dapat dipetakan.
                    </div>

                </div>
            )}


            {/* =================================================
             * MAP COUNTER
             * ================================================= */}

            {validPoints.length >
                0 && (
                <div
                    style={{
                        position:
                            "absolute",
                        top: 12,
                        left: 12,
                        zIndex: 500,
                        padding:
                            "7px 11px",
                        borderRadius: 8,
                        background:
                            "rgba(7, 17, 31, 0.88)",
                        border:
                            "1px solid rgba(255,255,255,0.12)",
                        color:
                            "#ffffff",
                        fontSize: 12,
                        fontWeight: 700,
                        pointerEvents:
                            "none",
                        boxShadow:
                            "0 2px 8px rgba(0,0,0,0.25)",
                    }}
                >
                    {validPoints.length.toLocaleString(
                        "id-ID",
                    )}{" "}
                    titik suspect
                </div>
            )}

        </div>
    );
}