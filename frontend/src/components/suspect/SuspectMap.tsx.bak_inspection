import {
    useEffect,
    useMemo,
} from "react";

import {
    CircleMarker,
    MapContainer,
    Popup,
    TileLayer,
    useMap,
} from "react-leaflet";

import "leaflet/dist/leaflet.css";

import type {
    SuspectMapPoint,
} from "../../api/suspect";


interface SuspectMapProps {
    points: SuspectMapPoint[];
    height?: number;
}


/* ============================================================
 * DEFAULT MAP
 * ============================================================ */

const DEFAULT_CENTER: [number, number] = [
    -5.3971,
    105.2668,
];

const DEFAULT_ZOOM = 11;

const SINGLE_POINT_ZOOM = 15;

const MAX_ZOOM = 15;


/* ============================================================
 * MAP FITTER
 * ============================================================ */

function MapFitter({
    points,
}: {
    points: SuspectMapPoint[];
}) {
    const map = useMap();

    const bounds = useMemo(() => {
        return points
            .filter(
                (point) =>
                    Number.isFinite(
                        Number(
                            point.latitude,
                        ),
                    ) &&
                    Number.isFinite(
                        Number(
                            point.longitude,
                        ),
                    ),
            )
            .map(
                (point) =>
                    [
                        Number(
                            point.latitude,
                        ),
                        Number(
                            point.longitude,
                        ),
                    ] as [
                        number,
                        number,
                    ],
            );
    }, [points]);


    useEffect(() => {
        const timer =
            window.setTimeout(() => {

                map.invalidateSize({
                    animate: false,
                });


                if (
                    bounds.length === 0
                ) {
                    map.setView(
                        DEFAULT_CENTER,
                        DEFAULT_ZOOM,
                    );

                    return;
                }


                if (
                    bounds.length === 1
                ) {
                    map.setView(
                        bounds[0],
                        SINGLE_POINT_ZOOM,
                    );

                    return;
                }


                map.fitBounds(
                    bounds,
                    {
                        padding: [
                            36,
                            36,
                        ],
                        maxZoom:
                            MAX_ZOOM,
                    },
                );

            }, 50);


        return () => {
            window.clearTimeout(
                timer,
            );
        };

    }, [
        map,
        bounds,
    ]);


    return null;
}


/* ============================================================
 * COLOR
 * ============================================================ */

function getPointColor(
    suspectName?:
        | string
        | null,
): string {

    const value =
        String(
            suspectName ?? "",
        )
            .trim()
            .toUpperCase();


    if (
        value.includes(
            "OVER VOLTAGE",
        )
    ) {
        return "#ef4444";
    }


    if (
        value.includes(
            "UNDER VOLTAGE",
        )
    ) {
        return "#f59e0b";
    }


    if (
        value.includes(
            "OVER CURRENT",
        )
    ) {
        return "#f97316";
    }


    if (
        value.includes(
            "UNBALANCE",
        )
    ) {
        return "#a855f7";
    }


    if (
        value.includes(
            "INCORRECT PHASE",
        )
    ) {
        return "#06b6d4";
    }


    if (
        value.includes(
            "ASYMMETRIC",
        )
    ) {
        return "#3b82f6";
    }


    if (
        value.includes(
            "REVERSAL",
        )
    ) {
        return "#ec4899";
    }


    if (
        value.includes(
            "TIME DIFFERENCE",
        )
    ) {
        return "#84cc16";
    }


    if (
        value.includes(
            "VOLTAGE DIP",
        )
    ) {
        return "#14b8a6";
    }


    return "#2563eb";
}


/* ============================================================
 * NUMBER
 * ============================================================ */

function formatNumber(
    value:
        | number
        | string
        | null
        | undefined,
): string {

    if (
        value === null ||
        value === undefined ||
        value === "" ||
        !Number.isFinite(
            Number(value),
        )
    ) {
        return "-";
    }


    return Number(
        value,
    ).toLocaleString(
        "id-ID",
    );
}


/* ============================================================
 * COORDINATE SOURCE
 * ============================================================ */

function getCoordinateSourceLabel(
    source:
        | "customer_location"
        | "pengecekan"
        | null
        | undefined,
): string {

    switch (source) {

        case "customer_location":
            return "Master Lokasi Pelanggan";

        case "pengecekan":
            return "Data Pengecekan";

        default:
            return "-";
    }
}


/* ============================================================
 * GOOGLE MAPS
 * ============================================================ */

function openGoogleMaps(
    latitude:
        | number
        | string
        | null
        | undefined,
    longitude:
        | number
        | string
        | null
        | undefined,
): void {

    const lat =
        Number(latitude);

    const lon =
        Number(longitude);


    if (
        !Number.isFinite(lat) ||
        !Number.isFinite(lon)
    ) {
        return;
    }


    const url =
        "https://www.google.com/maps/search/?api=1&query=" +
        encodeURIComponent(
            `${lat},${lon}`,
        );


    window.open(
        url,
        "_blank",
        "noopener,noreferrer",
    );
}


